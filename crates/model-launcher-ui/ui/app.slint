import { Button, ComboBox, LineEdit, ScrollView, StandardListView, TabWidget } from "std-widgets.slint";
import { ModelRow, ModelDisplay } from "components/model-row.slint";
import { LoadDialog } from "components/load-dialog.slint";

export { ModelDisplay }

export component MainWindow inherits Window {
    title: "Model Launcher";
    preferred-width: 840px; preferred-height: 620px; min-width: 400px; min-height: 420px;
    background: #F7F8FA;
    in property <[ModelDisplay]> models;
    in property <string> service-status: "Stopped";
    in property <string> base-url: "http://127.0.0.1:1234";
    in property <[string]> logs;
    in-out property <int> page: 0;
    callback load-model(string);
    callback eject-model(string);
    callback rescan(); callback copy-text(string); callback export-logs(); callback save-settings(string, string, string);

    VerticalLayout { spacing: 0px;
        Rectangle {
            height: 38px; background: #F7F8FA;
            HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 10px;
                Text { text: "Model Launcher"; color: #1F2937; font-family: "Segoe UI"; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.service-status; color: #667085; font-family: "Segoe UI"; font-size: 12px; vertical-alignment: center; }
            }
        }
        Rectangle { height: 2px; background: root.service-status == "Running" ? #2563EB : #E5E7EB; }
        Rectangle {
            height: 48px; background: #FFFFFF;
            HorizontalLayout { padding-left: 12px; spacing: 4px;
                nav-models := Button { text: "Models"; checked: root.page==0; clicked => { root.page=0; } }
                Button { text: "Server"; checked: root.page==1; clicked => { root.page=1; } }
                Button { text: "Logs"; checked: root.page==2; clicked => { root.page=2; } }
                Button { text: "Settings"; checked: root.page==3; clicked => { root.page=3; } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: #E5E7EB; }
        }
        Rectangle {
            background: #F7F8FA;
            if root.page == 0: VerticalLayout {
                padding: 16px; spacing: 10px;
                HorizontalLayout { spacing: 8px; search := LineEdit { placeholder-text: "Search models"; accessible-label: "Search models"; } Button { text: "Rescan"; clicked => { root.rescan(); } } }
                Rectangle { background: #FFFFFF; border-radius: 6px; border-width: 1px; border-color: #E5E7EB;
                    ScrollView { VerticalLayout { spacing: 0px; for row in root.models: ModelRow { model: row; show-size: root.width >= 500px; show-path: root.width >= 720px; action(id) => { row.action == "Eject" ? root.eject-model(id) : root.load-model(id); } } } }
                }
            }
            if root.page == 1: VerticalLayout { padding: 20px; spacing: 12px; Text { text: "Server"; font-family: "Segoe UI"; font-size: 20px; color: #1F2937; } Text { text: "Public base URL"; color: #667085; font-family: "Segoe UI"; } HorizontalLayout { Text { text: root.base-url; color: #1F2937; font-family: "Segoe UI"; } Button { text: "Copy"; clicked => { root.copy-text(root.base-url); } } } Text { text: "Authentication tokens are shown once and cannot be recovered."; color: #667085; font-family: "Segoe UI"; } Rectangle { vertical-stretch: 1; } }
            if root.page == 2: VerticalLayout { padding: 16px; spacing: 8px; HorizontalLayout { ComboBox { model: ["All sources", "Application", "Engine stdout", "Engine stderr"]; } ComboBox { model: ["Trace", "Debug", "Info", "Warn", "Error"]; } Rectangle { horizontal-stretch: 1; } Button { text: "Export"; clicked => { root.export-logs(); } } } Rectangle { background: #FFFFFF; border-width: 1px; border-color: #E5E7EB; ScrollView { VerticalLayout { for line in root.logs: Text { text: line; color: #1F2937; font-family: "Cascadia Mono"; font-size: 11px; wrap: word-wrap; } } } } }
            if root.page == 3: VerticalLayout { padding: 20px; spacing: 8px; Text { text: "Settings"; font-family: "Segoe UI"; font-size: 20px; color: #1F2937; } Text { text: "Model directory"; color: #667085; font-family: "Segoe UI"; } dir := LineEdit { accessible-label: "Model directory"; } Text { text: "WSL distribution"; color: #667085; font-family: "Segoe UI"; } distro := LineEdit { accessible-label: "WSL distribution"; } Text { text: "llama-server path"; color: #667085; font-family: "Segoe UI"; } exe := LineEdit { accessible-label: "llama-server path"; } Button { text: "Save settings"; primary: true; clicked => { root.save-settings(dir.text, distro.text, exe.text); } } Text { text: "Saving validates the engine identity and probes supported settings again."; color: #667085; font-family: "Segoe UI"; } Rectangle { vertical-stretch: 1; } }
        }
    }
}
