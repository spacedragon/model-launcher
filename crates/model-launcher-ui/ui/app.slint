import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, StandardListView, TabWidget } from "std-widgets.slint";
import { ModelRow, ModelDisplay } from "components/model-row.slint";
import { LoadDialog } from "components/load-dialog.slint";

export { ModelDisplay }

export component MainWindow inherits Window {
    title: "Model Launcher";
    preferred-width: 840px; preferred-height: 620px; min-width: 400px; min-height: 420px;
    background: #F7F8FA;
    in property <[ModelDisplay]> models;
    in-out property <string> search-query;
    in property <string> service-status: "Stopped";
    in property <string> operation-status;
    in property <string> base-url: "http://127.0.0.1:1234";
    in property <string> authentication-status;
    in property <string> server-warning;
    in property <string> engine-diagnostic;
    in property <[string]> logs;
    in property <string> log-copy-text;
    in-out property <string> generated-token;
    in-out property <bool> close-notice-open: false;
    in-out property <string> close-notice-message;
    in-out property <string> model-directory;
    in-out property <string> engine-distribution;
    in-out property <string> engine-executable;
    in-out property <int> default-context: 4096;
    in-out property <int> default-gpu: 0;
    in-out property <int> default-threads: 0;
    in-out property <int> default-batch: 512;
    in-out property <int> default-parallel: 1;
    in-out property <bool> default-flash: false;
    in-out property <string> default-kv: "f16";
    in-out property <int> page: 0;
    in-out property <bool> load-dialog-open: false;
    in-out property <string> selected-model-id;
    in-out property <string> selected-model-key;
    in-out property <int> selected-context: 4096; in-out property <int> selected-gpu: 0; in-out property <int> selected-threads: 1;
    in-out property <int> selected-batch: 512; in-out property <int> selected-parallel: 1; in-out property <bool> selected-flash: false; in-out property <string> selected-kv: "f16";
    in-out property <bool> selected-show-context; in-out property <bool> selected-show-gpu; in-out property <bool> selected-show-threads; in-out property <bool> selected-show-batch; in-out property <bool> selected-show-parallel; in-out property <bool> selected-show-flash; in-out property <bool> selected-show-kv;
    in-out property <bool> selected-unsupported-context; in-out property <bool> selected-unsupported-gpu; in-out property <bool> selected-unsupported-threads; in-out property <bool> selected-unsupported-batch; in-out property <bool> selected-unsupported-parallel; in-out property <bool> selected-unsupported-flash; in-out property <bool> selected-unsupported-kv;
    in-out property <bool> selected-clear-context; in-out property <bool> selected-clear-gpu; in-out property <bool> selected-clear-threads; in-out property <bool> selected-clear-batch; in-out property <bool> selected-clear-parallel; in-out property <bool> selected-clear-flash; in-out property <bool> selected-clear-kv;
    in property <bool> cap-context; in property <bool> cap-gpu; in property <bool> cap-threads;
    in property <bool> cap-batch; in property <bool> cap-parallel; in property <bool> cap-flash; in property <bool> cap-kv;
    callback load-model(string, string, int, int, int, int, int, bool, string, bool, bool, bool, bool, bool, bool, bool);
    callback eject-model(string);
    callback rescan(); callback copy-text(string); callback copy-token(string); callback export-logs(); callback save-settings(string, string, string, int, int, int, int, int, bool, string);
    callback generate-token();
    callback dismiss-token();
    callback confirm-close-to-tray();
    callback filter-logs(string, string);
    callback search-models(string);
    callback prepare-load(string);

    VerticalLayout { spacing: 0px;
        Rectangle {
            height: 38px; background: #F7F8FA;
            HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 10px;
                Text { text: "Model Launcher"; color: #1F2937; font-family: "Segoe UI"; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.service-status; color: #667085; font-family: "Segoe UI"; font-size: 12px; vertical-alignment: center; }
                Text { visible: root.operation-status != ""; text: root.operation-status; color: #667085; font-family: "Segoe UI"; font-size: 11px; vertical-alignment: center; }
            }
        }
        Rectangle { height: 2px; background: root.service-status == "Running" ? #2563EB : #E5E7EB; }
        Rectangle {
            height: 48px; background: #FFFFFF;
            HorizontalLayout { padding-left: 12px; spacing: 4px;
                nav-models := Button { text: "Models"; checked: root.page==0; clicked => { root.dismiss-token(); root.page=0; } }
                Button { text: "Server"; checked: root.page==1; clicked => { root.dismiss-token(); root.page=1; } }
                Button { text: "Logs"; checked: root.page==2; clicked => { root.dismiss-token(); root.page=2; } }
                Button { text: "Settings"; checked: root.page==3; clicked => { root.dismiss-token(); root.page=3; } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: #E5E7EB; }
        }
        Rectangle {
            background: #F7F8FA;
            if root.page == 0: VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { visible: root.engine-diagnostic != ""; text: "Engine unavailable: " + root.engine-diagnostic; color: #B42318; font-family: "Segoe UI"; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px; search := LineEdit { text <=> root.search-query; placeholder-text: "Search models"; accessible-label: "Search models"; edited => { root.search-models(self.text); } } Button { text: "Rescan"; clicked => { root.rescan(); } } }
                Rectangle { background: #FFFFFF; border-radius: 6px; border-width: 1px; border-color: #E5E7EB;
                    ScrollView { VerticalLayout { spacing: 0px; for row in root.models: ModelRow { model: row; show-size: root.width >= 500px; show-path: root.width >= 720px; action(id) => { if row.action == "Eject" { root.eject-model(id); } else { root.prepare-load(id); } } } } }
                }
            }
            if root.page == 1: VerticalLayout { padding: 20px; spacing: 12px; Text { text: "Server"; font-family: "Segoe UI"; font-size: 20px; color: #1F2937; } Text { text: "Listener address"; color: #667085; font-family: "Segoe UI"; } HorizontalLayout { Text { text: root.base-url; color: #1F2937; font-family: "Segoe UI"; } Button { text: "Copy"; clicked => { root.copy-text(root.base-url); } } } Text { text: root.authentication-status; color: #1F2937; font-family: "Segoe UI"; } Text { visible: root.server-warning != ""; text: root.server-warning; color: #B54708; font-family: "Segoe UI"; wrap: word-wrap; } Text { text: "Authentication tokens are shown once and cannot be recovered."; color: #667085; font-family: "Segoe UI"; } Button { text: "Generate token"; clicked => { root.generate-token(); } } HorizontalLayout { visible: root.generated-token != ""; LineEdit { text: root.generated-token; read-only: true; accessible-label: "New authentication token"; } Button { text: "Copy token"; clicked => { root.copy-token(root.generated-token); } } Button { text: "Dismiss"; clicked => { root.dismiss-token(); } } } Rectangle { vertical-stretch: 1; } }
            if root.page == 2: VerticalLayout { padding: 16px; spacing: 8px; HorizontalLayout { source-filter := ComboBox { model: ["All sources", "Application", "Engine stdout", "Engine stderr"]; } level-filter := ComboBox { model: ["Trace", "Debug", "Info", "Warn", "Error"]; } Button { text: "Apply filters"; clicked => { root.filter-logs(source-filter.current-value, level-filter.current-value); } } Rectangle { horizontal-stretch: 1; } Button { text: "Copy current"; clicked => { root.copy-text(root.log-copy-text); } } Button { text: "Export"; clicked => { root.export-logs(); } } } Rectangle { background: #FFFFFF; border-width: 1px; border-color: #E5E7EB; ScrollView { VerticalLayout { for line in root.logs: Text { text: line; color: #1F2937; font-family: "Cascadia Mono"; font-size: 11px; wrap: word-wrap; } } } } }
            if root.page == 3: ScrollView { VerticalLayout { padding: 20px; spacing: 8px; Text { text: "Settings"; font-family: "Segoe UI"; font-size: 20px; color: #1F2937; } Text { visible: root.engine-diagnostic != ""; text: "Engine validation failed: " + root.engine-diagnostic; color: #B42318; font-family: "Segoe UI"; wrap: word-wrap; } Text { text: "Model directory"; color: #667085; font-family: "Segoe UI"; } dir := LineEdit { text <=> root.model-directory; accessible-label: "Model directory"; } Text { text: "WSL distribution"; color: #667085; font-family: "Segoe UI"; } distro := LineEdit { text <=> root.engine-distribution; accessible-label: "WSL distribution"; } Text { text: "llama-server path"; color: #667085; font-family: "Segoe UI"; } exe := LineEdit { text <=> root.engine-executable; accessible-label: "llama-server path"; } Text { text: "Defaults for newly discovered models"; color: #1F2937; font-family: "Segoe UI"; font-weight: 600; } HorizontalLayout { Text { text: "Context"; } SpinBox { value <=> root.default-context; minimum: 1; maximum: 1048576; } Text { text: "GPU layers"; } SpinBox { value <=> root.default-gpu; minimum: 0; maximum: 4096; } Text { text: "Threads"; } SpinBox { value <=> root.default-threads; minimum: 0; maximum: 1024; } } HorizontalLayout { Text { text: "Batch"; } SpinBox { value <=> root.default-batch; minimum: 1; maximum: 1048576; } Text { text: "Parallel"; } SpinBox { value <=> root.default-parallel; minimum: 1; maximum: 1024; } CheckBox { text: "Flash attention"; checked <=> root.default-flash; } Text { text: "KV cache"; } ComboBox { current-value <=> root.default-kv; model: ["f16", "q8_0", "q4_0"]; accessible-label: "Default KV cache type"; } } Button { text: "Save settings"; primary: true; clicked => { root.save-settings(dir.text, distro.text, exe.text, root.default-context, root.default-gpu, root.default-threads, root.default-batch, root.default-parallel, root.default-flash, root.default-kv); } } Text { text: "Saving validates the directory and engine, switches the live catalog watcher, and reprobes supported settings."; color: #667085; font-family: "Segoe UI"; wrap: word-wrap; } } }
        }
    }
    if root.close-notice-open: Rectangle { background: #80000000; VerticalLayout { alignment: center; HorizontalLayout { alignment: center; Rectangle { width: 420px; height: 170px; background: #FFFFFF; border-radius: 8px; border-width: 1px; border-color: #E5E7EB; VerticalLayout { padding: 20px; spacing: 14px; Text { text: "Keep Model Launcher running"; font-family: "Segoe UI"; font-size: 18px; font-weight: 600; color: #1F2937; } Text { text: root.close-notice-message; font-family: "Segoe UI"; color: #667085; wrap: word-wrap; } HorizontalLayout { Rectangle { horizontal-stretch: 1; } Button { text: "Continue to tray"; primary: true; clicked => { root.close-notice-open=false; root.confirm-close-to-tray(); } } } } } } } }
    LoadDialog { open <=> root.load-dialog-open; model-key <=> root.selected-model-key; context-value <=> root.selected-context; gpu-value <=> root.selected-gpu; threads-value <=> root.selected-threads; batch-value <=> root.selected-batch; parallel-value <=> root.selected-parallel; flash-value <=> root.selected-flash; kv-value <=> root.selected-kv; clear-context <=> root.selected-clear-context; clear-gpu <=> root.selected-clear-gpu; clear-threads <=> root.selected-clear-threads; clear-batch <=> root.selected-clear-batch; clear-parallel <=> root.selected-clear-parallel; clear-flash <=> root.selected-clear-flash; clear-kv <=> root.selected-clear-kv; show-context: root.selected-show-context; show-gpu: root.selected-show-gpu; show-threads: root.selected-show-threads; show-batch: root.selected-show-batch; show-parallel: root.selected-show-parallel; show-flash: root.selected-show-flash; show-kv: root.selected-show-kv; unsupported-context: root.selected-unsupported-context; unsupported-gpu: root.selected-unsupported-gpu; unsupported-threads: root.selected-unsupported-threads; unsupported-batch: root.selected-unsupported-batch; unsupported-parallel: root.selected-unsupported-parallel; unsupported-flash: root.selected-unsupported-flash; unsupported-kv: root.selected-unsupported-kv; confirm(key, context, gpu, threads, batch, parallel, flash, kv, clear-context, clear-gpu, clear-threads, clear-batch, clear-parallel, clear-flash, clear-kv) => { root.load-model(root.selected-model-id, key, context, gpu, threads, batch, parallel, flash, kv, clear-context, clear-gpu, clear-threads, clear-batch, clear-parallel, clear-flash, clear-kv); root.load-dialog-open=false; } }
}
