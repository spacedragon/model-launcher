{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Launcher",
  "version": "0.2.0",
  "identifier": "io.modellauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Model Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["../../apps/model-launcher/resources/app.ico"]
  }
}
